body {
    margin: 0;
    font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
    background-image: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url(cj.jpg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    color: #e0e0e0;
}

header {
    background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url(bg2.jpg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: white;
    text-align: center;
    padding: 50px 20px;
}

main {
    max-width: 1100px;
    margin: 30px auto;
    padding: 0 20px;
}

section {
    background-color: #1e1e1e;
    padding: 25px;
    border-radius: 8px;
    margin-bottom: 30px;
    border: 1px solid #2c2c2c;
}

section h2 {
    color: #ffffff;
    margin-bottom: 20px;
}

nav {
    background-color: #1e1e1e;
}

nav ul {
    list-style: none;
    margin: 0;
    padding: 0%;
    display: flex;
    justify-content: center;
}

nav a {
    display: block;
    color: white;
    text-decoration: none;
    padding: 15px 20px;
}

nav a:hover {
    background-color: blanchedalmond;
}

.produk-container {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px;
    margin-top: 20px;
}

.produk-card {
    border: 1px solid #333;
    padding: 15px;
    background-color: #262626;
    border-radius: 6px;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.produk-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 4px;
}

.paket-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
}

.paket-card {
    border: 1px solid #333;
    padding: 15px;
    background-color: #262626;
    border-radius: 6px;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.paket-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    object-position: top;
    border-radius: 4px;
}

.menu section {
    background-color: #1e1e1e;
    padding: 25px;
    border-radius: 8px;
    margin-bottom: 30px;
    border: 1px solid #2c2c2c;
}

.menu-section h2 {
    color: #ffffff;
    margin-bottom: 20px;
}

.btn-beli, .btn-daftar {
    width: 100%;
    padding: 10px;
    margin-top: 10px;
    background-color: crimson;
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.3 ease;
}

.btn-beli:hover, .btn-daftar:hover {
    background-color: #a3000a;
}

.harga {
    font-weight: bold;
    color: #4caf50;
    margin-top: 10px;
}