body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #2b2b2b;
}

.navbar-header{
    background-color: #175fbe;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 15px 40px;
    color: white;
    width: 100%;
    box-sizing: border-box;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 25px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-size: 14px;
}

.nav-links a:hover {
    text-decoration: underline;
}

.hero-banner-riwayat {
    height: 180px;
    background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('bg2.jpg');
    background-size: cover;
    background-position: center;
}

main {
    display: flex;
    justify-content: center;
    padding: 0 20px;
    margin-top: -50px;
    position: relative;
    z-index: 10;
}

.riwayat-section {
    background-color: white !important;
    color: #333333 !important;
    padding: 30px !important;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    width: 100%;
    max-width: 900px;
    box-sizing: border-box;
}

.riwayat-header  {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.riwayat-header h2 {
    color: #333333 !important;
    margin: 0px;
    font-size: 20px;
}

.filter-buttons {
    display: flex;
    gap: 10px;
}

.btn-filter {
    padding: 8px 20px;
    border-radius: 20px;
    border: none;
    font-weight: bold;
    cursor: pointer;
    background-color: #000;
    color: white;
    transition: background 0.3s;
}

.btn-filter.active, .btn-filter.hover {
    background-color: #f9dd07;
}

.riwayat-kosong {
    text-align: center;
    padding: 40px 0;
    color: #777;
    font-style: italic;
    font-size: 15px;
}